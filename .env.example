# --- provider selection -------------------------------------------------
# LLM_PROVIDER:       local | openai | anthropic | mistral
# EMBEDDING_PROVIDER: local | openai | mistral
# These two are independent: e.g. local embeddings + Mistral generation.
LLM_PROVIDER=mistral
EMBEDDING_PROVIDER=mistral

# --- credentials (only the selected provider's key is required) ---------
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- models (optional, sensible defaults in app/core/config.py) ---------
MISTRAL_LLM_MODEL=ministral-8b-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed
# OPENAI_LLM_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# ANTHROPIC_LLM_MODEL=claude-sonnet-5
# OLLAMA_LLM_MODEL=llama3.1
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# --- generation defaults (provider-independent) -------------------------
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=3

# --- vector store -------------------------------------------------------
QDRANT_URL=http://localhost:6333
# Embedding dimensions differ per provider -- use one collection per embedder.
QDRANT_COLLECTION=nis2_mistral
